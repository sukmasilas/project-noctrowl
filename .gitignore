# Secrets — never commit real credentials
.env
.env.*
!.env.example
secrets/*
!secrets/README.md

# Real sample documents — contain real account numbers/names, kept local-only.
# Structure (READMEs) is tracked; actual files are not.
sample-documents/**
!sample-documents/**/
!sample-documents/README.md
!sample-documents/*/.gitkeep
*.json
!package.json
!package-lock.json
!tsconfig.json

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# Local throwaway SQLite DB (fallback when DATABASE_URL isn't set — never real data)
*.db
*.sqlite
*.sqlite3

# OS / editor
.DS_Store
.vscode/
.idea/
*.probe
.probe
