# Template only — copy to .env and fill in real values there. .env is gitignored; this file is not.
# Never paste real secrets into chat or commit them here.

# --- PostgreSQL (needed starting milestone 2 — core ledger engine) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Use a dedicated app-specific Postgres user/database — not the postgres superuser.
#
# Local dev (milestone 2, now): point this at a local Postgres (or local Docker
# container) while Builder is iterating on the schema/ledger engine. This does
# NOT need to be the DigitalOcean droplet yet.
#   e.g. DATABASE_URL=postgresql://noctrowl_app:password@localhost:5432/noctrowl
#
# Deployed on the droplet (milestone 4/5, later): the app and Postgres both run
# on the droplet itself, so the value is still "localhost" from the app's own
# point of view — same variable, different environment, not a different shape.
#   e.g. DATABASE_URL=postgresql://noctrowl_app:password@localhost:5432/noctrowl
#
# Do NOT expose Postgres's port (5432) to the public internet to connect to it
# remotely from elsewhere — DigitalOcean's default firewall blocking it is
# correct and should stay that way. If you ever genuinely need remote access
# (e.g. from a local machine, not the droplet itself), use an SSH tunnel
# rather than opening the port.
DATABASE_URL=postgresql://user:password@localhost:5432/noctrowl

# --- Google Cloud (needed starting milestone 3 — manual data ingestion via Drive) ---
# Drive API scope ONLY. Sheets API is not needed — Sheets is not part of this architecture.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- App login (needed starting milestone 4 — basic single-user login gate) ---
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD=

# --- eBay Developer (DEFERRED — not needed for the prototype) ---
# eBay sales data is a manual CSV upload for now (see CLAUDE.md: Data sources & inputs,
# Build milestones). Leave these blank/commented until the eBay API sync milestone is
# actually scheduled — don't fill in or wire up early.
# EBAY_APP_ID=
# EBAY_CERT_ID=
# EBAY_DEV_ID=
# EBAY_REFRESH_TOKEN=
# EBAY_ENV=production

# --- DigitalOcean droplet ---
# Deliberately no env vars here — the app never reads DigitalOcean credentials
# at runtime, and nothing in this project automates droplet management (no
# DIGITALOCEAN_API_TOKEN, no doctl/Terraform). If that ever changes, add real
# fields here then — don't add them speculatively now.
#
# What you actually need, kept OUTSIDE this file:
#   - Your SSH private key (e.g. ~/.ssh/id_ed25519) — used to log into the
#     droplet directly, not something the app reads.
#   - The droplet's IP address or hostname, for `ssh <user>@<droplet-ip>`.
# Before deployment (milestone 4/5), confirm you can still SSH in with these.
